<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

  <display-name>BranchDesk</display-name>

  <filter>
    <filter-name>wicket.branchdesk</filter-name>
    <filter-class>org.apache.wicket.protocol.http.WicketFilter</filter-class>
    <init-param>
      <param-name>applicationClassName</param-name>
      <param-value>com.meridianbranch.branchdesk.BranchDeskApplication</param-value>
    </init-param>
    <!-- development | deployment. Keep development for the demo (full error pages). -->
    <init-param>
      <param-name>configuration</param-name>
      <param-value>development</param-value>
    </init-param>
  </filter>

  <filter-mapping>
    <filter-name>wicket.branchdesk</filter-name>
    <url-pattern>/*</url-pattern>
  </filter-mapping>

</web-app>
